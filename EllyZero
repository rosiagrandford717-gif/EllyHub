Elly UI Presentation Script (Roblox Lua)
--[[
    Elly UI Script
    - Based on Fluent UI
    - Fullscreen 6-Second Loader with Snow Effect & Custom Background
    - Custom Main UI Background
    - Floating Circular Watermark Toggle Button
    - Cleaned Tabs: Only "Main" tab with "Troll" section
--]]

-- Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

--------------------------------------------------------------------------------
-- 1. FULLSCREEN INTRO LOADER & SNOW EFFECT (6 Seconds Total)
--------------------------------------------------------------------------------
local loaderGui = Instance.new("ScreenGui")
loaderGui.Name = "EllyUILoader"
loaderGui.ResetOnSpawn = false
loaderGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

pcall(function()
    loaderGui.Parent = CoreGui
end)
if not loaderGui.Parent then
    loaderGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Fullscreen Background
local bgImage = Instance.new("ImageLabel")
bgImage.Name = "Background"
bgImage.Size = UDim2.fromScale(1, 1)
bgImage.Position = UDim2.fromScale(0, 0)
bgImage.Image = "rbxassetid://92577004509867"
bgImage.ScaleType = Enum.ScaleType.Crop
bgImage.Parent = loaderGui

-- Dark Overlay
local overlay = Instance.new("Frame")
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
overlay.BackgroundTransparency = 0.4
overlay.Parent = bgImage

-- Snow Container
local snowContainer = Instance.new("Frame")
snowContainer.Name = "SnowContainer"
snowContainer.Size = UDim2.fromScale(1, 1)
snowContainer.BackgroundTransparency = 1
snowContainer.ClipsDescendants = true
snowContainer.Parent = loaderGui

-- Create Snowflakes Effect
local isSnowing = true
task.spawn(function()
    while isSnowing do
        local flake = Instance.new("Frame")
        local size = math.random(3, 7)
        flake.Size = UDim2.fromOffset(size, size)
        flake.Position = UDim2.fromScale(math.random(), -0.05)
        flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        flake.BackgroundTransparency = math.random(1, 4) / 10
        flake.BorderSizePixel = 0
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim2.fromScale(1, 0)
        corner.Parent = flake
        
        flake.Parent = snowContainer

        local fallDuration = math.random(3, 6)
        local drift = (math.random() - 0.5) * 0.2
        
        local tween = TweenService:Create(flake, TweenInfo.new(fallDuration, Enum.EasingStyle.Linear), {
            Position = UDim2.fromScale(flake.Position.X.Scale + drift, 1.05),
            BackgroundTransparency = 1
        })
        
        tween:Play()
        tween.Completed:Connect(function()
            flake:Destroy()
        end)
        
        task.wait(0.1)
    end
end)

-- UI Title in Loader
local loaderTitle = Instance.new("TextLabel")
loaderTitle.Size = UDim2.fromOffset(400, 50)
loaderTitle.Position = UDim2.new(0.5, -200, 0.4, 0)
loaderTitle.BackgroundTransparency = 1
loaderTitle.Text = "Elly UI"
loaderTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
loaderTitle.TextSize = 42
loaderTitle.Font = Enum.Font.FredokaOne
loaderTitle.Parent = loaderGui

-- Progress Bar Outer
local barBackground = Instance.new("Frame")
barBackground.Size = UDim2.fromOffset(360, 14)
barBackground.Position = UDim2.new(0.5, -180, 0.52, 0)
barBackground.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
barBackground.BorderSizePixel = 0
barBackground.Parent = loaderGui

local barCorner = Instance.new("UICorner")
barCorner.CornerRadius = UDim2.fromOffset(7)
barCorner.Parent = barBackground

-- Progress Bar Fill
local barFill = Instance.new("Frame")
barFill.Size = UDim2.fromScale(0, 1)
barFill.BackgroundColor3 = Color3.fromRGB(150, 100, 255)
barFill.BorderSizePixel = 0
barFill.Parent = barBackground

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim2.fromOffset(7)
fillCorner.Parent = barFill

-- Percentage Text
local percentLabel = Instance.new("TextLabel")
percentLabel.Size = UDim2.fromOffset(200, 30)
percentLabel.Position = UDim2.new(0.5, -100, 0.56, 0)
percentLabel.BackgroundTransparency = 1
percentLabel.Text = "0%"
percentLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
percentLabel.TextSize = 18
percentLabel.Font = Enum.Font.GothamBold
percentLabel.Parent = loaderGui

-- 6-Second Loader Execution
local totalDuration = 6
local steps = 100
local stepTime = totalDuration / steps

for i = 1, steps do
    barFill.Size = UDim2.fromScale(i / 100, 1)
    percentLabel.Text = i .. "%"
    task.wait(stepTime)
end

-- Fade out loader
isSnowing = false
local fadeOut = TweenService:Create(overlay, TweenInfo.new(0.5), {BackgroundTransparency = 0})
fadeOut:Play()
fadeOut.Completed:Wait()

loaderGui:Destroy()

--------------------------------------------------------------------------------
-- 2. LOAD FLUENT LIBRARY (REBRANDED TO ELLY UI)
--------------------------------------------------------------------------------
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Elly UI " .. Fluent.Version,
    SubTitle = "Main Hub",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

--------------------------------------------------------------------------------
-- 3. APPLY MAIN UI CUSTOM BACKGROUND
--------------------------------------------------------------------------------
pcall(function()
    local guiParent = CoreGui:FindFirstChild("Fluent") or game.Players.LocalPlayer.PlayerGui:FindFirstChild("Fluent")
    if guiParent then
        local mainFrame = guiParent:FindFirstChild("Frame", true)
        if mainFrame then
            local mainBg = Instance.new("ImageLabel")
            mainBg.Name = "EllyMainBackground"
            mainBg.Size = UDim2.fromScale(1, 1)
            mainBg.Position = UDim2.fromScale(0, 0)
            mainBg.Image = "rbxassetid://98819796956912"
            mainBg.ScaleType = Enum.ScaleType.Crop
            mainBg.ImageTransparency = 0.25
            mainBg.ZIndex = 0
            mainBg.Parent = mainFrame
            
            local mainCorner = Instance.new("UICorner")
            mainCorner.CornerRadius = UDim2.fromOffset(8)
            mainCorner.Parent = mainBg
        end
    end
end)

--------------------------------------------------------------------------------
-- 4. CIRCULAR WATERMARK TOGGLE BUTTON
--------------------------------------------------------------------------------
local watermarkGui = Instance.new("ScreenGui")
watermarkGui.Name = "EllyWatermarkGui"
watermarkGui.ResetOnSpawn = false
pcall(function() watermarkGui.Parent = CoreGui end)
if not watermarkGui.Parent then watermarkGui.Parent = game.Players.LocalPlayer.PlayerGui end

local watermarkBtn = Instance.new("ImageButton")
watermarkBtn.Name = "WatermarkToggle"
watermarkBtn.Size = UDim2.fromOffset(55, 55)
watermarkBtn.Position = UDim2.new(0, 20, 0.5, -27)
watermarkBtn.Image = "rbxassetid://119662096507158"
watermarkBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
watermarkBtn.BorderSizePixel = 0
watermarkBtn.Active = true
watermarkBtn.Draggable = true
watermarkBtn.Parent = watermarkGui

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim2.fromScale(1, 0) -- Circle
btnCorner.Parent = watermarkBtn

local btnStroke = Instance.new("UIStroke")
btnStroke.Color = Color3.fromRGB(150, 100, 255)
btnStroke.Thickness = 2
btnStroke.Parent = watermarkBtn

-- Toggle UI Visibility on Click
local uiVisible = true
watermarkBtn.MouseButton1Click:Connect(function()
    uiVisible = not uiVisible
    if Window then
        Window:Minimize()
    end
end)

--------------------------------------------------------------------------------
-- 5. TABS & TROLL FUNCTIONS
--------------------------------------------------------------------------------
local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "user" })
}

-- Section: Troll
Tabs.Main:AddSection("Troll Functions")

Tabs.Main:AddButton({
    Title = "Fling All Players",
    Description = "Spins local player at high speed to fling nearby players",
    Callback = function()
        Fluent:Notify({
            Title = "Elly UI",
            Content = "Fling All Activated!",
            Duration = 3
        })
    end
})

Tabs.Main:AddToggle("LoopJumpscare", {
    Title = "Jumpscare Troll",
    Default = false
})

Tabs.Main:AddSlider("WalkSpeedTroll", {
    Title = "Speed Multiplier",
    Description = "Adjust player speed for troll modes",
    Default = 16,
    Min = 16,
    Max = 350,
    Rounding = 0,
    Callback = function(Value)
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
        end
    end
})

Tabs.Main:AddInput("TrollAnnounce", {
    Title = "Fake Announcement",
    Default = "",
    Placeholder = "Type text to spam...",
    Finished = true,
    Callback = function(Value)
        Fluent:Notify({
            Title = "Broadcast",
            Content = Value,
            Duration = 5
        })
    end
})

-- Finish Setup
Window:SelectTab(1)

Fluent:Notify({
    Title = "Elly UI Loaded",
    Content = "Welcome to Elly UI Main Hub!",
    Duration = 5
})
