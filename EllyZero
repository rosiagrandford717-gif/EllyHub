local KornluvElly = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

---------------------------------------------------------
-- ตัวแปรควบคุมระบบทั้งหมด
---------------------------------------------------------
local isScriptRunning = true
local WatermarkGui = nil

---------------------------------------------------------
-- สร้างหน้าต่างหลัก (Window) - Theme Rose พาสเทล
---------------------------------------------------------
local Window = KornluvElly:CreateWindow({
    Title = "KornluvElly",
    SubTitle = "by dawid",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false,
    Theme = "Rose",
    MinimizeKey = Enum.KeyCode.LeftControl
})

---------------------------------------------------------
-- ฟังก์ชันสำหรับลบและหยุดการทำงานทั้งหมด
---------------------------------------------------------
local function DestroyUI()
    isScriptRunning = false

    if WatermarkGui then
        WatermarkGui:Destroy()
        WatermarkGui = nil
    end

    local CoreGui = game:GetService("CoreGui")
    local oldWatermark = CoreGui:FindFirstChild("KornluvEllyWatermark") or (gethui and gethui():FindFirstChild("KornluvEllyWatermark"))
    if oldWatermark then
        oldWatermark:Destroy()
    end

    KornluvElly:Destroy()
end

---------------------------------------------------------
-- ส่วนของ Tabs และ Elements
---------------------------------------------------------
local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "home" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

do
    ---------------------------------------------------------
    -- หมวดหมู่: General (Main Tab)
    ---------------------------------------------------------
    Tabs.Main:AddSection("General")

    -- ฟังก์ชัน Troll ตัวอย่าง
    Tabs.Main:AddButton({
        Title = "Troll Function",
        Description = "กดเพื่อใช้งานฟังก์ชัน Troll",
        Callback = function()
            print("Troll function activated!")
            -- ใส่โค้ดการทำงานของฟังก์ชัน Troll ที่นี่
        end
    })

    ---------------------------------------------------------
    -- หมวดหมู่: Settings (Settings Tab)
    ---------------------------------------------------------
    Tabs.Settings:AddSection("Script Unload")

    Tabs.Settings:AddButton({
        Title = "Destroy UI (ทำลายตัวเอง)",
        Description = "ปิดการทำงานทั้งหมด ลบ Watermark และลบ UI ออกจากเกม",
        Callback = function()
            DestroyUI()
        end
    })
end
